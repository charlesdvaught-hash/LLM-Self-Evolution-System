FROM pytorch/pytorch:2.1.0-cuda12.1-runtime-ubuntu22.04

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install FusionBench and dependencies
RUN pip install --no-cache-dir \
    fusion-bench>=0.2.0 \
    lm-eval>=0.4.0 \
    torch==2.1.0 \
    transformers>=4.36.0 \
    accelerate>=0.24.0 \
    peft>=0.7.0 \
    safetensors>=0.4.0 \
    pyyaml>=6.0 \
    hydra-core>=1.3.0 \
    lightning>=2.0.0

# Create directories
RUN mkdir -p /app/data /app/configs /app/results

# FusionBench entrypoint
ENTRYPOINT ["python", "-m", "fusion_bench"]
CMD ["--help"]
