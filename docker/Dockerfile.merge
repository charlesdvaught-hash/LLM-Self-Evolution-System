FROM python:3.10-slim
WORKDIR /app

RUN apt-get update && apt-get install -y git build-essential && rm -rf /var/lib/apt/lists/*

# Core ML stack
RUN pip install --no-cache-dir \
    torch \
    transformers \
    accelerate \
    pyyaml \
    mergekit

# FusionBench: 15+ advanced merging methods
RUN pip install --no-cache-dir fusion-bench hydra-core lightning

ENTRYPOINT ["mergekit-yaml"]
