FROM python:3.10-slim

WORKDIR /app

# Install system dependencies (cached)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI (cached)
RUN curl -fsSL https://download.docker.com/linux/debian/gpg | apt-key add - && \
    apt-get update && apt-get install -y --no-install-recommends docker-ce-cli && \
    rm -rf /var/lib/apt/lists/* || true

# Upgrade pip (cached)
RUN pip install --upgrade pip setuptools wheel

# Install PyTorch (CPU to save space and memory on WSL) (cached)
RUN pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# llama-cpp-python for GGUF advisor models (CPU build; GPU offload via n_gpu_layers) (cached)
RUN pip install llama-cpp-python --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cpu

# Copy ONLY requirements.txt first (cached)
COPY requirements.txt .

# Install Python dependencies (cached)
RUN pip install -r requirements.txt

# Copy entire app last (fast, not cached when files change)
COPY . /app

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

EXPOSE 8501 8888

CMD ["streamlit", "run", "/app/breeding_vat/ui/app.py", "--server.address=0.0.0.0"]
