FROM python:3.10-slim
WORKDIR /app

RUN apt-get update && apt-get install -y git build-essential && rm -rf /var/lib/apt/lists/*

# Core ML stack
RUN pip install --no-cache-dir \
    torch \
    transformers \
    accelerate \
    pyyaml \
    mergekit

# FusionBench: 15+ advanced merging methods
RUN pip install --no-cache-dir fusion-bench hydra-core lightning

# Copy the wrapper script
COPY scripts/mergekit_wrapper.py /app/scripts/mergekit_wrapper.py

# Use the wrapper as entrypoint to apply the patch automatically
ENTRYPOINT ["python", "/app/scripts/mergekit_wrapper.py"]
