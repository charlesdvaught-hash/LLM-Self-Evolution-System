FROM pytorch/pytorch:2.0-cuda11.8-runtime-ubuntu22.04

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install -q --upgrade pip && pip install -q \
    torch==2.0.0 \
    transformers==4.36.0 \
    accelerate==0.25.0 \
    peft==0.7.0 \
    numpy==1.24.0 \
    scikit-learn==1.3.0 \
    einops==0.7.0

# Copy breeding_vat code
COPY breeding_vat/ /app/breeding_vat/

# Create necessary directories
RUN mkdir -p /app/data /app/configs /app/output

# Set environment
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/root/.cache/huggingface

# Default command
ENTRYPOINT ["python", "-c"]
CMD ["import sys; print('InfiFusion container ready'); sys.exit(0)"]
